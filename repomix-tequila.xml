<file path="tequila/lca_engine/templates/lca_engine/benchmark.html">
{% extends "lca_engine/base.html" %}

{% block title %}Tequila Class Benchmark | Tequila LCA Studio Enterprise{% endblock %}

{% block content %}
<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold text-white mb-1" data-i18n="benchmark_title">Tequila Class Comparative Benchmarking</h2>
        <p class="text-muted mb-0">
            <span data-i18n="benchmark_subtitle">Side-by-side Environmental Impact Comparison across Tequila Classes for</span> 
            <strong class="text-light">{{ producer.name }}</strong>
        </p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a href="{% url 'dashboard' %}" class="btn btn-outline-light" data-i18n="back_dashboard">← Back to Dashboard</a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card p-4 h-100">
            <h5 class="fw-bold mb-3 text-white" data-i18n="gwp_by_class">Carbon Footprint (GWP100a) by Class</h5>
            <canvas id="gwpBenchmarkChart" height="220"></canvas>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card p-4 h-100">
            <h5 class="fw-bold mb-3 text-white" data-i18n="water_by_class">AWARE Water Footprint by Class</h5>
            <canvas id="waterBenchmarkChart" height="220"></canvas>
        </div>
    </div>
</div>

<div class="card p-4">
    <h5 class="fw-bold mb-1 text-white" data-i18n="sensitivity_title">Sensitivity Curve: Impact of Glass Recycling Rate</h5>
    <p class="text-muted small mb-3" data-i18n="sensitivity_subtitle">Demonstrates how increasing recycled glass content reduces GWP across classes with varying bottle weights.</p>
    <canvas id="sensitivityChart" height="180"></canvas>
</div>

<script id="benchmark-data" type="application/json">
    {{ benchmark_json|safe }}
</script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const benchData = JSON.parse(document.getElementById("benchmark-data").textContent);

        const darkTooltipConfig = {
            backgroundColor: '#1e293b',
            titleColor: '#ffffff',
            bodyColor: '#00f2fe',
            borderColor: '#334155',
            borderWidth: 1
        };

        // GWP Benchmark Bar Chart with Cyan-Pink Neon Palette & Explicit Y Axis Title (UI-1)
        new Chart(document.getElementById('gwpBenchmarkChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: benchData.labels,
                datasets: [{
                    label: 'Climate Footprint (kg CO2-eq)',
                    data: benchData.gwp,
                    backgroundColor: ['#00f2fe', '#4facfe', '#a18cd1', '#fbc2eb'],
                    borderColor: 'rgba(255, 255, 255, 0.2)',
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: { 
                responsive: true, 
                plugins: { 
                    legend: { display: false },
                    tooltip: darkTooltipConfig
                },
                scales: {
                    x: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: { color: '#94a3b8' }
                    },
                    y: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: { color: '#94a3b8' },
                        title: { display: true, text: 'kg CO2-eq per bottle', color: '#94a3b8', font: { family: 'Inter, sans-serif' } }
                    }
                }
            }
        });

        // Water Benchmark Bar Chart with Green-Cyan Neon Palette & Explicit Y Axis Title (UI-1)
        new Chart(document.getElementById('waterBenchmarkChart').getContext('2d'), {
            type: 'bar',
            data: {
                labels: benchData.labels,
                datasets: [{
                    label: 'AWARE Water Footprint (m3 world-eq)',
                    data: benchData.water,
                    backgroundColor: ['#43e97b', '#38f9d7', '#4facfe', '#00f2fe'],
                    borderColor: 'rgba(255, 255, 255, 0.2)',
                    borderWidth: 1,
                    borderRadius: 6
                }]
            },
            options: { 
                responsive: true, 
                plugins: { 
                    legend: { display: false },
                    tooltip: darkTooltipConfig
                },
                scales: {
                    x: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: { color: '#94a3b8' }
                    },
                    y: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: { color: '#94a3b8' },
                        title: { display: true, text: 'm3 world-eq per bottle', color: '#94a3b8', font: { family: 'Inter, sans-serif' } }
                    }
                }
            }
        });

        // Sensitivity Line Chart with Neon Line Accents & Explicit Y Axis Title (UI-1)
        new Chart(document.getElementById('sensitivityChart').getContext('2d'), {
            type: 'line',
            data: {
                labels: ['0% Recycled', '25% Recycled', '50% Recycled', '75% Recycled', '100% Recycled'],
                datasets: [
                    { label: 'Blanco', data: [4.85, 4.62, 4.40, 4.18, 3.95], borderColor: '#00f2fe', backgroundColor: '#00f2fe', borderWidth: 2.5, tension: 0.2, fill: false },
                    { label: 'Reposado', data: [8.16, 7.82, 7.48, 7.14, 6.80], borderColor: '#4facfe', backgroundColor: '#4facfe', borderWidth: 2.5, tension: 0.2, fill: false },
                    { label: 'Añejo', data: [9.45, 9.05, 8.65, 8.25, 7.85], borderColor: '#a18cd1', backgroundColor: '#a18cd1', borderWidth: 2.5, tension: 0.2, fill: false },
                    { label: 'Extra Añejo', data: [11.20, 10.70, 10.20, 9.70, 9.20], borderColor: '#fbc2eb', backgroundColor: '#fbc2eb', borderWidth: 2.5, tension: 0.2, fill: false }
                ]
            },
            options: { 
                responsive: true,
                plugins: {
                    legend: {
                        labels: { color: '#f8fafc', font: { family: 'Inter, sans-serif' } }
                    },
                    tooltip: darkTooltipConfig
                },
                scales: {
                    x: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: { color: '#94a3b8' }
                    },
                    y: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: { color: '#94a3b8' },
                        title: { display: true, text: 'kg CO2-eq per bottle', color: '#94a3b8', font: { family: 'Inter, sans-serif' } }
                    }
                }
            }
        });
    });
</script>
{% endblock %}
</file>

<file path="tequila/lca_engine/templates/lca_engine/dashboard.html">
{% extends "lca_engine/base.html" %}

{% block title %}Dashboard | Tequila LCA Studio Enterprise{% endblock %}

{% block content %}
<div class="row mb-4 align-items-center">
    <div class="col-12">
        <h2 class="fw-bold text-white mb-1">{{ scenario.product.name|default:scenario.name }}</h2>
        <p class="text-muted mb-0">
            <span data-i18n="producer">Producer</span>: <strong class="text-light">{{ scenario.product.producer.name|default:"Destilería Los Altos" }}</strong> | 
            <span data-i18n="class">Class</span>: <span class="text-light">{{ scenario.product.get_tequila_class_display|default:"Reposado" }}</span>
        </p>
    </div>
</div>


<!-- Global Scenario Parameters Form -->
<div class="card p-4 mb-4" id="control-panel-card">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="fw-bold text-white mb-0" data-i18n="control_panel_title">Scenario Control Panel</h5>
        <span id="recalc-badge" class="badge bg-warning text-dark d-none px-3 py-2 fw-bold animate-fade" data-i18n="recalc_required">⚠️ Recalculation Required</span>
    </div>
    <form method="get" id="scenario-form" class="row g-3 align-items-center">
        <div class="col-md-5">
            <label class="form-label fw-bold small text-uppercase text-muted" data-i18n="functional_unit">Functional Unit Volume</label>
            {{ param_form.functional_unit }}
        </div>
        <div class="col-md-5">
            <label class="form-label fw-bold small text-uppercase text-muted" data-i18n="glass_recycling">Glass Recycling Rate (Slider)</label>
            {{ param_form.glass_recycling_rate }}
            <output class="fw-bold" style="color: #00f2fe;">{{ param_form.glass_recycling_rate.value|default:12 }}%</output>
        </div>
        <div class="col-md-2 text-end mt-4">
            <button type="submit" class="btn btn-primary w-100 fw-semibold" style="background: linear-gradient(135deg, #00f2fe, #4facfe); border: none; color: #0f172a;" data-i18n="recalculate">Recalculate</button>
        </div>
    </form>
</div>

<!-- Key Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card p-3 stat-card" style="--card-accent: #00f2fe;">
            <span class="text-muted small text-uppercase" data-i18n="climate_footprint">Climate Footprint (GWP100)</span>
            <h3 class="fw-bold my-1" style="color: #00f2fe; text-shadow: 0 0 12px rgba(0, 242, 254, 0.3);">{{ results.gwp_score }} <small class="fs-6 text-muted">kg CO2-eq</small></h3>
            <span class="small text-muted">Per {{ results.functional_unit_ml }}ml Bottle</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 stat-card" style="--card-accent: #38f9d7;">
            <span class="text-muted small text-uppercase" data-i18n="water_footprint">AWARE Water Footprint</span>
            <h3 class="fw-bold my-1" style="color: #38f9d7; text-shadow: 0 0 12px rgba(56, 249, 215, 0.3);">{{ results.water_footprint_aware }} <small class="fs-6 text-muted">m3 world-eq</small></h3>
            <span class="small text-muted">Water scarcity weighted</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 stat-card" style="--card-accent: #43e97b;">
            <span class="text-muted small text-uppercase" data-i18n="biogenic_co2">Biogenic CO2 Emissions</span>
            <h3 class="fw-bold my-1" style="color: #43e97b; text-shadow: 0 0 12px rgba(67, 233, 123, 0.3);">{{ results.biogenic_co2 }} <small class="fs-6 text-muted">kg</small></h3>
            <span class="small text-muted">Fermentation stoichiometry</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card p-3 stat-card" style="--card-accent: #a18cd1;">
            <span class="text-muted small text-uppercase" data-i18n="background_db">Background DB Mode</span>
            <h6 class="fw-bold my-2">
                <span class="badge bg-success" style="font-size: 0.85rem;">{{ results.db_mode }}</span>
            </h6>
            <span class="small text-muted">Glass Recycled: {{ results.glass_recycling_rate_pct }}%</span>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Chart.js Interactive Hotspots -->
    <div class="col-lg-6">
        <div class="card p-3 h-100 chart-container-card">
            <h5 class="fw-bold mb-3 text-white" data-i18n="hotspot_title">Interactive Hotspot Breakdown</h5>
            <canvas id="hotspotChart" height="220"></canvas>
        </div>
    </div>

    <!-- Plotly.js Process Flow Sankey Diagram -->
    <div class="col-lg-6">
        <div class="card p-3 h-100 chart-container-card">
            <h5 class="fw-bold mb-3 text-white" data-i18n="process_flow_title">Lifecycle Process Flow</h5>
            <div id="sankeyDiagram" style="height: 250px;"></div>
        </div>
    </div>
</div>

<div class="card p-4">
    <h5 class="fw-bold mb-3 text-white" data-i18n="hotspot_table_title">Hotspot Contribution Table</h5>
    <div class="table-responsive">
        <table class="table table-hover table-dark align-middle mb-0">
            <thead>
                <tr>
                    <th data-i18n="col_process">Lifecycle Process / Credit</th>
                    <th class="text-end" data-i18n="col_gwp">GWP Impact (kg CO2-eq)</th>
                    <th class="text-end" data-i18n="col_share">Share of Total (%)</th>
                </tr>
            </thead>
            <tbody>
                {% for h in results.hotspots %}
                <tr>
                    <td>{{ h.stage }}</td>
                    <td class="text-end {% if h.gwp_score < 0 %}text-success fw-bold{% endif %}">{{ h.gwp_score }}</td>
                    <td class="text-end fw-bold" style="color: #00f2fe;">{{ h.pct }}%</td>
                </tr>
                {% empty %}
                <tr>
                    <td colspan="3" class="text-center text-muted">No inventory exchanges found.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>

<!-- Embedded JSON Results Payload -->
<script id="lca-results-data" type="application/json">
    {{ results_json|safe }}
</script>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const rawData = JSON.parse(document.getElementById("lca-results-data").textContent);

        // Stateful UX-3 Feedback: Listen to input changes in Control Panel
        const formInputs = document.querySelectorAll("#scenario-form input, #scenario-form select");
        const recalcBadge = document.getElementById("recalc-badge");
        const chartCards = document.querySelectorAll(".chart-container-card");

        formInputs.forEach(input => {
            input.addEventListener("input", function() {
                if (recalcBadge) recalcBadge.classList.remove("d-none");
                chartCards.forEach(c => {
                    c.style.opacity = "0.75";
                    c.style.border = "1px dashed #f59e0b";
                });
            });
        });

        // Render Chart.js Hotspot Bar Chart with Neon Palette & Dark Gridlines
        const stages = rawData.hotspots.slice(0, 6).map(h => h.stage);
        const pcts = rawData.hotspots.slice(0, 6).map(h => h.pct);

        const ctx = document.getElementById('hotspotChart').getContext('2d');
        
        // Gradient fill for bars
        const cyanGradient = ctx.createLinearGradient(0, 0, 400, 0);
        cyanGradient.addColorStop(0, '#00f2fe');
        cyanGradient.addColorStop(1, '#4facfe');

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: stages,
                datasets: [{
                    label: 'GWP Contribution (%)',
                    data: pcts,
                    backgroundColor: cyanGradient,
                    borderColor: '#00f2fe',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { 
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1e293b',
                        titleColor: '#ffffff',
                        bodyColor: '#00f2fe',
                        borderColor: '#334155',
                        borderWidth: 1
                    }
                },
                scales: {
                    x: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: { color: '#94a3b8' }
                    },
                    y: {
                        grid: { color: 'rgba(255, 255, 255, 0.1)' },
                        ticks: { color: '#94a3b8' }
                    }
                }
            }
        });

        // Render Plotly.js Process Flow Sankey Diagram with Dark Mode Neon Theme (UI-3)
        const sankeyData = [{
            type: "sankey",
            orientation: "h",
            node: {
                pad: 15,
                thickness: 20,
                line: { color: "#ffffff", width: 0.5 },
                label: ["Agave Cultivation", "Cooking & Grinding", "Fermentation", "Distillation", "Packaging", "Functional Product Output"],
                color: ["#00f2fe", "#4facfe", "#a18cd1", "#fbc2eb", "#43e97b", "#38f9d7"]
            },
            link: {
                source: [0, 1, 2, 3, 4],
                target: [1, 2, 3, 5, 5],
                value:  [3.01, 2.51, 0.12, 1.20, 1.32],
                color: ["rgba(0, 242, 254, 0.25)", "rgba(79, 172, 254, 0.25)", "rgba(161, 140, 209, 0.25)", "rgba(251, 194, 235, 0.25)", "rgba(67, 233, 123, 0.25)"]
            }
        }];
        const sankeyLayout = { 
            margin: { l: 10, r: 10, t: 10, b: 10 },
            paper_bgcolor: 'rgba(0,0,0,0)',
            plot_bgcolor: 'rgba(0,0,0,0)',
            font: { color: '#ffffff', family: 'Inter, sans-serif' }
        };
        Plotly.newPlot('sankeyDiagram', sankeyData, sankeyLayout, {responsive: true, displayModeBar: false});
    });
</script>
{% endblock %}
</file>

<file path="tequila/lca_engine/templates/lca_engine/inventory_form.html">
{% extends "lca_engine/base.html" %}

{% block title %}Edit Inventory | Tequila LCA Studio Enterprise{% endblock %}

{% block content %}
<div class="row mb-4 align-items-center">
    <div class="col-md-8">
        <h2 class="fw-bold text-white mb-1" data-i18n="inventory_title">Inventory Management</h2>
        <p class="text-muted mb-0" data-i18n="inventory_subtitle">Upload a bulk inventory CSV file or edit lifecycle exchanges manually below.</p>
    </div>
    <div class="col-md-4 text-md-end mt-3 mt-md-0">
        <a href="{% url 'dashboard' %}" class="btn btn-outline-light" data-i18n="back_dashboard">← Back to Dashboard</a>
    </div>
</div>

<div class="card p-4 mb-4">
    <h5 class="fw-bold mb-3 text-white" data-i18n="csv_upload_title">Bulk CSV Upload</h5>
    <form method="post" enctype="multipart/form-data" class="row g-3 align-items-center">
        {% csrf_token %}
        <div class="col-md-7">
            <label class="form-label text-muted small text-uppercase fw-bold">Select CSV File</label>
            {{ upload_form.csv_file }}
            <div class="form-text text-muted mt-1">Required CSV headers: <code>stage_name, category, query, amount, unit, location, exchange_type</code></div>
        </div>
        <div class="col-md-5">
            <label class="form-label text-muted small text-uppercase fw-bold">Upload Mode</label>
            <div class="d-flex gap-3 mt-1">
                {% for radio in upload_form.upload_mode %}
                <div class="form-check">
                    {{ radio.tag }}
                    <label class="form-check-label text-light small fw-medium" for="{{ radio.id_for_label }}">{{ radio.choice_label }}</label>
                </div>
                {% endfor %}
            </div>
        </div>
        <div class="col-12 text-end mt-3 border-top border-secondary border-opacity-25 pt-3">
            <button type="submit" name="upload_csv" class="btn btn-success px-4 fw-semibold" data-i18n="upload_process_btn">Upload & Process CSV</button>
        </div>
    </form>
</div>

<div class="card p-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h5 class="fw-bold text-white mb-0" data-i18n="manual_form_title">Manual Inventory Formset Editor</h5>
        <span class="badge bg-secondary opacity-75 fs-7">{{ formset|length }} Exchanges</span>
    </div>
    
    <form method="post">
        {% csrf_token %}
        {{ formset.management_form }}
        
        <div class="table-responsive">
            <table class="table table-bordered table-dark align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width: 22%;">Stage Name</th>
                        <th style="width: 18%;">Category</th>
                        <th style="width: 22%;">DB Search Query</th>
                        <th style="width: 10%;">Amount</th>
                        <th style="width: 8%;">Unit</th>
                        <th style="width: 8%;">Location</th>
                        <th style="width: 10%;">Type</th>
                        <th class="text-center" style="width: 4%;">Delete</th>
                    </tr>
                </thead>
                <tbody>
                    {% for form in formset %}
                    <tr>
                        {{ form.id }}
                        <td>{{ form.stage_name }}</td>
                        <td>{{ form.category }}</td>
                        <td>{{ form.query }}</td>
                        <td>{{ form.amount }}</td>
                        <td>{{ form.unit }}</td>
                        <td>{{ form.location }}</td>
                        <td>{{ form.exchange_type }}</td>
                        <td class="text-center">
                            {% if form.instance.pk %}
                                {{ form.DELETE }}
                            {% endif %}
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="mt-4 text-end">
            <button type="submit" class="btn btn-primary px-4 fw-semibold" style="background: linear-gradient(135deg, #00f2fe, #4facfe); border: none; color: #0f172a;" data-i18n="save_recalculate">Save & Recalculate LCA</button>
        </div>
    </form>
</div>
{% endblock %}
